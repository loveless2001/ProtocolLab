        },
        "input_symbol": {
          "enum": [
            "SUBMIT_A",
            "SUBMIT_B",
            "SIGNAL_X",
            "SIGNAL_Y",
            "CANCEL",
            "STATUS",
            "INSPECT",
            "TICK"
          ],
          "title": "Input Symbol",

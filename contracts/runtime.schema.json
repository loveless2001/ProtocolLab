            "alphabet_hash",
            "normalizer_hash",
            "operation_registry_hash",
            "governance_interface_hash",
            "task_schema_hash"
          ],
          "title": "ProtectedDependencies",
          "type": "object"
        },
        "Transition": {
          "additionalProperties": false,
          "properties": {
            "from_state": {
              "pattern": "^[a-zA-Z0-9_-]{1,64}$",
              "title": "From State",
              "type": "string"
            },
            "input": {
              "enum": [
                "SUBMIT_A",
                "SUBMIT_B",
                "SIGNAL_X",
                "SIGNAL_Y",
                "CANCEL",
                "STATUS",
                "INSPECT",
                "TICK"
              ],
              "title": "Input",
              "type": "string"
            },
            "to_state": {
              "pattern": "^[a-zA-Z0-9_-]{1,64}$",
              "title": "To State",
              "type": "string"
            },
            "output": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Output",
              "type": "string"
            }
          },
          "required": [
            "from_state",
            "input",
            "to_state",
            "output"
          ],
          "title": "Transition",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "model.artifact",
          "default": "model.artifact",
          "title": "Kind",
          "type": "string"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "initial_state": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Initial State",
          "type": "string"
        },
        "states": {
          "items": {
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "States",
          "type": "array"
        },
        "alphabet": {
          "items": {
            "enum": [
              "SUBMIT_A",
              "SUBMIT_B",
              "SIGNAL_X",
              "SIGNAL_Y",
              "CANCEL",
              "STATUS",
              "INSPECT",
              "TICK"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Alphabet",
          "type": "array"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "maxItems": 512,
          "minItems": 8,
          "title": "Transitions",
          "type": "array"
        },
        "training_trace_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Training Trace Refs",
          "type": "array"
        },
        "protected_dependencies": {
          "$ref": "#/$defs/ProtectedDependencies"
        },
        "evidence_status": {
          "default": "DRAFT",
          "enum": [
            "DRAFT",
            "CONSISTENT_WITH_TESTED_TRACES",
            "QUARANTINED"
          ],
          "title": "Evidence Status",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "namespace",
        "revision",
        "initial_state",
        "states",
        "alphabet",
        "transitions",
        "protected_dependencies"
      ],
      "title": "ModelArtifact",
      "type": "object"
    },

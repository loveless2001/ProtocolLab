        "ProtectedDependencies": {
          "additionalProperties": false,
          "properties": {
            "alphabet_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Alphabet Hash",
              "type": "string"
            },
            "normalizer_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Normalizer Hash",
              "type": "string"
            },
            "operation_registry_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Operation Registry Hash",
              "type": "string"
            },
            "governance_interface_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Governance Interface Hash",
              "type": "string"
            },
            "task_schema_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Task Schema Hash",
              "type": "string"
            }
          },
          "required": [
            "alphabet_hash",
            "normalizer_hash",
            "operation_registry_hash",
            "governance_interface_hash",
            "task_schema_hash"
          ],
          "title": "ProtectedDependencies",
          "type": "object"

              "type": "string"
            },
            "normalizer_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Normalizer Hash",
              "type": "string"
            },
            "operation_registry_hash": {
              "pattern": "^[a-f0-9]{64}$",
